def fetch_workspace(workspace_id=None):
    """Fetch workspace metadata."""
    return _run_json(["multica", "workspace", "get", "--output", "json"], workspace_id=workspace_id)


def fetch_labels(workspace_id=None):
    """Fetch labels list."""
    return _run_json(["multica", "label", "list", "--output", "json"], workspace_id=workspace_id) or []


def fetch_skills(workspace_id=None):
    """Fetch skills with full content and files."""
    skills = _run_json(["multica", "skill", "list", "--output", "json"], workspace_id=workspace_id) or []
    full_skills = []
    for skill in skills:
        detail = _run_json(["multica", "skill", "get", skill["id"], "--output", "json"], workspace_id=workspace_id)
        if detail:
            full_skills.append(detail)
        else:
            full_skills.append(skill)
    return full_skills


def fetch_agents(workspace_id=None):
