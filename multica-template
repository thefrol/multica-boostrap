def fetch_workspace_members_list(workspace_id=None):
    """Fetch workspace members list."""
    return _run_json(["multica", "workspace", "members", "--output", "json"], workspace_id=workspace_id) or []


def fetch_autopilots(workspace_id=None):
    """Fetch autopilots with full details and triggers."""
    resp = _run_json(["multica", "autopilot", "list", "--output", "json"], workspace_id=workspace_id)
    autopilots = []
    if isinstance(resp, dict):
        autopilots = resp.get("autopilots", [])
    elif isinstance(resp, list):
        autopilots = resp

    full_autopilots = []
    for ap in autopilots:
        detail = _run_json(["multica", "autopilot", "get", ap["id"], "--output", "json"], workspace_id=workspace_id)
        if detail and isinstance(detail, dict) and "autopilot" in detail:
            ap_data = dict(detail["autopilot"])
            ap_data["triggers"] = detail.get("triggers", [])
            full_autopilots.append(ap_data)
        else:
            full_autopilots.append(ap)
    return full_autopilots


def build_template(workspace_id=None):
    """Query the workspace and build a template dict."""
    ws = fetch_workspace(workspace_id=workspace_id)
    labels = fetch_labels(workspace_id=workspace_id)
    skills = fetch_skills(workspace_id=workspace_id)
    agents = fetch_agents(workspace_id=workspace_id)
    squads = fetch_squads(workspace_id=workspace_id)
    autopilots = fetch_autopilots(workspace_id=workspace_id)

    # Build lookup tables: id -> name
    agent_id_to_name = {a["id"]: a["name"] for a in agents}
    skill_id_to_name = {s["id"]: s["name"] for s in skills}

    # Fetch workspace members for resolving human member IDs
    workspace_members = fetch_workspace_members_list(workspace_id=workspace_id)
    member_id_to_name = {m["id"]: m["name"] for m in workspace_members}

    template = {
        "apiVersion": "multica.template/v1",
        "kind": "WorkspaceTemplate",
        "metadata": {
            "name": ws.get("slug", "exported") if ws else "exported",
            "description": f"Auto-exported from workspace {ws.get('name', '')}" if ws else "Auto-exported workspace template",
        },
        "spec": {},
    }

    # Workspace metadata
    if ws:
        ws_spec = {}
        if ws.get("name"):
            ws_spec["name"] = ws["name"]
        if ws.get("description"):
            ws_spec["description"] = ws["description"]
        if ws.get("issue_prefix"):
            ws_spec["issuePrefix"] = ws["issue_prefix"]
        if ws_spec:
            template["spec"]["workspace"] = ws_spec

    # Labels
    if labels:
        template["spec"]["labels"] = [
            {"name": lbl["name"], "color": lbl["color"]}
            for lbl in labels
        ]

    # Skills
    if skills:
        skill_list = []
        for skill in skills:
            s = {
                "name": skill["name"],
            }
            if skill.get("description"):
                s["description"] = _normalize_text(skill["description"])
            if skill.get("content"):
                s["content"] = _normalize_text(skill["content"])
            if skill.get("files"):
                files = []
                for f in skill["files"]:
                    files.append({
                        "path": f["path"],
                        "content": _normalize_text(f["content"]),
                    })
                s["files"] = files
            skill_list.append(s)
        template["spec"]["skills"] = skill_list

    # Agents
    if agents:
        agent_list = []
        for agent in agents:
            a = {
                "name": agent["name"],
            }
            if agent.get("description"):
                a["description"] = _normalize_text(agent["description"])
            if agent.get("runtime_id"):
                a["runtimeId"] = agent["runtime_id"]
            if agent.get("model"):
                a["model"] = agent["model"]
            if agent.get("instructions"):
                a["instructions"] = _normalize_text(agent["instructions"])
            if agent.get("visibility"):
                a["visibility"] = agent["visibility"]
            if agent.get("max_concurrent_tasks") is not None:
                a["maxConcurrentTasks"] = agent["max_concurrent_tasks"]
            if agent.get("custom_args"):
                a["customArgs"] = agent["custom_args"]
            if agent.get("custom_env"):
                a["customEnv"] = agent["custom_env"]
            # Resolve skill IDs to names
            agent_skills = agent.get("skills") or []
            if agent_skills:
                skill_names = []
                for sk in agent_skills:
                    sk_id = sk["id"] if isinstance(sk, dict) else sk
                    sk_name = skill_id_to_name.get(sk_id)
                    if sk_name:
                        skill_names.append(sk_name)
                if skill_names:
                    a["skills"] = skill_names
            agent_list.append(a)
        template["spec"]["agents"] = agent_list

    # Squads
    if squads:
        squad_list = []
        for squad in squads:
            sq = {
                "name": squad["name"],
            }
            if squad.get("description"):
                sq["description"] = _normalize_text(squad["description"])
            if squad.get("instructions"):
                sq["instructions"] = _normalize_text(squad["instructions"])
            leader_id = squad.get("leader_id")
            if leader_id and leader_id in agent_id_to_name:
                sq["leader"] = agent_id_to_name[leader_id]
            elif leader_id:
                sq["leader"] = leader_id

            # Fetch and include squad members (excluding the leader)
            members = fetch_squad_members(squad["id"], workspace_id=workspace_id)
            if members:
                member_list = []
                for member in members:
                    member_id = member.get("member_id")
                    member_type = member.get("member_type", "agent")
                    role = member.get("role", "member")
                    # Skip the leader since it's already represented by the leader field
                    if member_id == leader_id and role == "leader":
                        continue
                    if member_type == "agent" and member_id in agent_id_to_name:
                        member_name = agent_id_to_name[member_id]
                    elif member_type == "member" and member_id in member_id_to_name:
                        member_name = member_id_to_name[member_id]
                    else:
                        member_name = member_id
                    member_list.append({
                        "name": member_name,
                        "type": member_type,
                        "role": role,
                    })
                if member_list:
                    sq["members"] = member_list
            squad_list.append(sq)
        template["spec"]["squads"] = squad_list

    # Autopilots
    if autopilots:
        autopilot_list = []
        for ap in autopilots:
            ap_out = {
                "name": ap.get("title") or ap.get("name", "unnamed"),
            }
            if ap.get("title"):
                ap_out["title"] = ap["title"]
            assignee_id = ap.get("assignee_id")
            if assignee_id and assignee_id in agent_id_to_name:
                ap_out["agent"] = agent_id_to_name[assignee_id]
            elif assignee_id:
                ap_out["agent"] = assignee_id
            if ap.get("execution_mode"):
                ap_out["mode"] = ap["execution_mode"]
            if ap.get("description"):
                ap_out["description"] = _normalize_text(ap["description"])
            if ap.get("priority"):
                ap_out["priority"] = ap["priority"]
            if ap.get("status"):
                ap_out["status"] = ap["status"]
            triggers = ap.get("triggers", [])
            if triggers:
                trigger_list = []
                for trig in triggers:
                    t = {}
                    if trig.get("cron_expression"):
                        t["cron"] = trig["cron_expression"]
                    if trig.get("timezone"):
                        t["timezone"] = trig["timezone"]
                    if trig.get("enabled") is not None:
                        t["enabled"] = trig["enabled"]
                    if trig.get("label"):
                        t["label"] = trig["label"]
                    trigger_list.append(t)
                if trigger_list:
                    ap_out["triggers"] = trigger_list
            autopilot_list.append(ap_out)
        template["spec"]["autopilots"] = autopilot_list

    return template


def write_template(template, output_dir):
    """Write template.yaml to the output directory."""
    if not os.path.isdir(output_dir):
        os.makedirs(output_dir, exist_ok=True)

    path = os.path.join(output_dir, "template.yaml")
    with open(path, "w", encoding="utf-8") as f:
        yaml.dump(template, f, default_flow_style=False, sort_keys=False, allow_unicode=True, Dumper=yaml.Dumper)

    return path


# ---------------------------------------------------------------------------
# Subcommand: apply
# ---------------------------------------------------------------------------

def cmd_apply(args):
    source = args.source
    tmpdir = None

    def _cleanup_tmpdir():
        if tmpdir:
            shutil.rmtree(tmpdir, ignore_errors=True)

    atexit.register(_cleanup_tmpdir)

    if is_github_url(source):
        parsed = parse_github_url(source)
        source, tmpdir = fetch_github_repo(parsed, explicit_ref=args.ref)
    elif args.ref:
        print("--ref can only be used with a GitHub source.", file=sys.stderr)
        sys.exit(1)

    template = load_template(
        source,
        values_files=getattr(args, "values", None),
        set_overrides=getattr(args, "set", None),
        env_file=getattr(args, "env_file", None),
    )

    target_ws = resolve_workspace(args, template, dry_run=args.dry_run)
    if target_ws:
        print(f"Target workspace: {target_ws}")
    else:
        print("Target workspace: current workspace")

    print(f"Template: {template['metadata']['name']}")
    print("Building registry from workspace state...")
    registry = build_registry(workspace_id=target_ws)
    print("Applying resources...\n")
    sys.stdout.flush()

    spec = template.get("spec", {})
    apply_workspace(spec, dry_run=args.dry_run, workspace_id=target_ws)
    apply_labels(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)
    apply_skills(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)
    apply_agents(spec, registry, dry_run=args.dry_run, workspace_id=target_ws, source_dir=source)
    apply_squads(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)
    apply_autopilots(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)

    print("\nDone.")


# ---------------------------------------------------------------------------
# Subcommand: dump
# ---------------------------------------------------------------------------

def cmd_dump(args):
    target_ws = resolve_workspace_simple(args)
    if target_ws:
        print(f"Source workspace: {target_ws}")
    else:
        print("Source workspace: current workspace")

    print("Fetching workspace state...")
    template = build_template(workspace_id=target_ws)

    env_file_path = getattr(args, "env_file", None)
    if env_file_path:
        env_vars = {}
        agents = template.get("spec", {}).get("agents") or []
        for agent in agents:
            custom_env = agent.get("customEnv")
            if not custom_env:
                continue
            agent_name = agent["name"]
            new_custom_env = {}
            for key, value in custom_env.items():
                env_key = f"{agent_name}_{key}".upper()
                env_key = re.sub(r"[^A-Z0-9_]", "_", env_key)
                env_vars[env_key] = str(value)
                new_custom_env[key] = f"{{{{ .Env.{env_key} }}}}"
            agent["customEnv"] = new_custom_env

        dotenv_full_path = os.path.join(args.output_dir, env_file_path)
        dotenv_dir = os.path.dirname(dotenv_full_path)
        if dotenv_dir and not os.path.isdir(dotenv_dir):
            os.makedirs(dotenv_dir, exist_ok=True)
        with open(dotenv_full_path, "w", encoding="utf-8") as f:
            for key, value in sorted(env_vars.items()):
                f.write(f"{key}={value}\n")
        print(f"Writing env file to {dotenv_full_path} ...")

    print(f"Writing template to {args.output_dir}/template.yaml ...")
    path = write_template(template, args.output_dir)

    print(f"Done. Exported to: {path}")


# ---------------------------------------------------------------------------
# Subcommand: clone
# ---------------------------------------------------------------------------

def cmd_clone(args):
    """Clone a workspace: dump from source, apply to target."""
    # Resolve source workspace
    source_ws = None
    if args.from_id:
        source_ws = args.from_id
    elif args.from_name:
        workspaces = _parse_workspace_list_table()
        if args.from_name not in workspaces:
            print(f'Source workspace "{args.from_name}" not found.', file=sys.stderr)
            sys.exit(1)
        source_ws = workspaces[args.from_name]
    else:
        source_ws = os.environ.get("MULTICA_WORKSPACE_ID")
        if not source_ws:
            print(
                "Source workspace not specified. Use --from-id or --from-name, "
                "or set MULTICA_WORKSPACE_ID.",
                file=sys.stderr,
            )
            sys.exit(1)

    print(f"Source workspace: {source_ws}")

    # Resolve target workspace
    target_ws = None
    if args.to_id:
        target_ws = args.to_id
    elif args.to_name:
        workspaces = _parse_workspace_list_table()
        if args.to_name not in workspaces:
            if args.create_workspace:
                if args.dry_run:
                    print(f'Target workspace "{args.to_name}" not found. Would create (dry-run).')
                    target_ws = DRY_RUN_ID
                else:
                    print(f'Target workspace "{args.to_name}" not found. Creating...')
                    target_ws = create_workspace(args.to_name)
            else:
                print(
                    f'Target workspace "{args.to_name}" not found. '
                    'Use --create-workspace to create it.',
                    file=sys.stderr,
                )
                sys.exit(1)
        else:
            target_ws = workspaces[args.to_name]
    else:
        print(
            "Target workspace not specified. Use --to-id or --to-name.",
            file=sys.stderr,
        )
        sys.exit(1)

    print(f"Target workspace: {target_ws}")

    # Dump source to temp directory
    tmpdir = tempfile.mkdtemp(prefix="multica-template-clone-")
    atexit.register(lambda: shutil.rmtree(tmpdir, ignore_errors=True))

    print("Fetching workspace state...")
    template = build_template(workspace_id=source_ws)

    template_path = write_template(template, tmpdir)
    print(f"Intermediate template: {template_path}")

    # Load and apply to target
    template = load_template(tmpdir)

    # Remove workspace name from the template so we don't rename the target
    spec = template.get("spec", {})
    if spec.get("workspace", {}).get("name"):
        del spec["workspace"]["name"]
        if not spec["workspace"]:
            del spec["workspace"]

    print("Building registry from target workspace state...")
    registry = build_registry(workspace_id=target_ws)
    print("Applying resources...\n")
    sys.stdout.flush()

    apply_workspace(spec, dry_run=args.dry_run, workspace_id=target_ws)
    apply_labels(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)
    apply_skills(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)
    apply_agents(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)
    apply_squads(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)
    apply_autopilots(spec, registry, dry_run=args.dry_run, workspace_id=target_ws)

    print("\nDone.")


# ---------------------------------------------------------------------------
# Main entry point
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        description="Declarative workspace provisioning for Multica.",
        usage="multica-template [-h] <command> [<args>]",
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    # ------------------------------------------------------------------
    # apply
    # ------------------------------------------------------------------
    apply_parser = subparsers.add_parser(
        "apply",
        help="Apply a workspace template",
        description="Apply a Multica workspace template to a target workspace.",
    )
    apply_parser.add_argument(
        "source",
        help=(
            "Path to directory containing template.yaml, "
            "or a GitHub repo reference such as github.com/owner/repo"
        ),
    )
    apply_parser.add_argument("--dry-run", action="store_true", help="Print commands without executing")
    apply_parser.add_argument("--workspace-id", help="Apply to an explicit workspace UUID")
    apply_parser.add_argument("--workspace-name", help="Resolve workspace name to ID and apply there")
    apply_parser.add_argument("--create-workspace", action="store_true", help="Create the target workspace if it does not exist")
    apply_parser.add_argument(
        "--ref",
        dest="ref",
        help="Git ref (branch or tag) to checkout when using a GitHub source",
    )
    apply_parser.add_argument(
        "--values",
        dest="values",
        action="append",
        help="Path to a values YAML file (can be given multiple times; later files override earlier ones)",
    )
    apply_parser.add_argument(
        "--set",
        dest="set",
        action="append",
        help="Set a value override (e.g. --set agent.model=gpt-4o). Can be given multiple times.",
    )
    apply_parser.add_argument(
        "--env-file",
        dest="env_file",
        help="Path to a .env file to load for {{ .Env.VARNAME }} template variables",
    )
    apply_parser.set_defaults(func=cmd_apply)

    # ------------------------------------------------------------------
    # dump
    # ------------------------------------------------------------------
    dump_parser = subparsers.add_parser(
        "dump",
        help="Export a workspace to a declarative template",
        description="Dump a Multica workspace to a declarative template.yaml file.",
    )
    dump_parser.add_argument("output_dir", help="Path to directory where template.yaml will be written")
    dump_parser.add_argument("--workspace-id", help="Dump from an explicit workspace UUID")
    dump_parser.add_argument("--workspace-name", help="Resolve workspace name to ID and dump from there")
    dump_parser.add_argument(
        "--env-file",
        dest="env_file",
        help="Extract agent customEnv values to a .env file and use {{ .Env.VARNAME }} placeholders in template.yaml",
    )
    dump_parser.set_defaults(func=cmd_dump)

    # ------------------------------------------------------------------
    # clone
    # ------------------------------------------------------------------
    clone_parser = subparsers.add_parser(
        "clone",
        help="Copy one workspace to another (dump + apply)",
        description="Clone a Multica workspace by dumping it and applying to another workspace.",
    )
    clone_parser.add_argument("--from-id", help="Source workspace UUID")
    clone_parser.add_argument("--from-name", help="Source workspace name")
    clone_parser.add_argument("--to-id", help="Target workspace UUID")
    clone_parser.add_argument("--to-name", help="Target workspace name")
    clone_parser.add_argument("--create-workspace", action="store_true", help="Create the target workspace if it does not exist")
    clone_parser.add_argument("--dry-run", action="store_true", help="Print commands without executing")
    clone_parser.set_defaults(func=cmd_clone)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
