#!/usr/bin/env python3
"""
multica-template — Unified CLI for declarative workspace provisioning.

Subcommands:
    apply   Apply a workspace template
    dump    Export a workspace to a declarative template
    clone   Copy one workspace to another (dump + apply)

Usage:
    multica-template apply ./examples/basic-workspace
    multica-template apply ./examples/agent-fleet --dry-run
    multica-template dump ./exported-template
    multica-template clone --from-id <uuid> --to-name "New Team" --create-workspace
"""

import argparse
import atexit
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import urllib.request

import yaml


# ---------------------------------------------------------------------------
# YAML customisation — multiline strings as literal blocks
# ---------------------------------------------------------------------------

def _str_representer(dumper, data):
    """Use literal block style (|) for strings containing newlines."""
    if '\n' in data:
        return dumper.represent_scalar('tag:yaml.org,2002:str', data, style='|')
    return dumper.represent_scalar('tag:yaml.org,2002:str', data)


yaml.add_representer(str, _str_representer)


def _normalize_text(text):
    """Strip trailing whitespace from each line to avoid YAML double-quoted \n escapes."""
    if not isinstance(text, str):
        return text
    return "\n".join(line.rstrip() for line in text.splitlines())


def parse_dotenv(path):
    """Parse a .env file and return a dict of key-value pairs.

    Supports:
      KEY=value
      KEY="value"
      KEY='value'
      export KEY=value
      # comments
      empty lines
    """
    result = {}
    with open(path, "r", encoding="utf-8") as f:
        for line in f:
            line = line.rstrip("\n\r")
            stripped = line.strip()
            if not stripped or stripped.startswith("#"):
                continue
            if stripped.startswith("export "):
                stripped = stripped[7:]
            if "=" not in stripped:
                continue
            key, value = stripped.split("=", 1)
            key = key.strip()
            value = value.strip()
            # Unquote
            if len(value) >= 2:
                if (value.startswith('"') and value.endswith('"')) or \
                   (value.startswith("'") and value.endswith("'")):
                    value = value[1:-1]
            result[key] = value
    return result


# ---------------------------------------------------------------------------
# Template rendering (Jinja2)
# ---------------------------------------------------------------------------

def _deep_merge(base, overlay):
    """Recursively merge overlay into base."""
    for key, value in overlay.items():
        if key in base and isinstance(base[key], dict) and isinstance(value, dict):
            _deep_merge(base[key], value)
        else:
            base[key] = value
    return base


def _parse_dot_notation(key, value):
    """Parse a dot-notation key like 'agent.model' into a nested dict."""
    parts = key.split(".")
    result = {}
    current = result
    for part in parts[:-1]:
        current[part] = {}
        current = current[part]
    current[parts[-1]] = value
    return result


def _infer_type(value):
    """Infer the Python type of a --set value string."""
    value = value.strip()
    if value.lower() == "true":
        return True
    if value.lower() == "false":
        return False
    if value.lower() in ("null", "none"):
        return None
    try:
        if "." in value and not (value.startswith("0") and len(value) > 1 and not value.startswith("0.")):
            # Avoid treating octal-like strings as floats
            return float(value)
        return int(value)
    except ValueError:
        pass
    # Strip explicit quotes
    if len(value) >= 2:
        if (value.startswith('"') and value.endswith('"')) or \
           (value.startswith("'") and value.endswith("'")):
            return value[1:-1]
    return value


def load_values(directory, values_files=None, set_overrides=None):
    """Load and merge values from values.yaml, --values files, and --set overrides.

    Returns a dict of merged values.
    """
    merged = {}

    # 1. Default values.yaml in template directory
    default_values_path = os.path.join(directory, "values.yaml")
    if os.path.isfile(default_values_path):
        with open(default_values_path, "r", encoding="utf-8") as f:
            data = yaml.safe_load(f)
        if isinstance(data, dict):
            merged.update(data)

    # 2. Explicit --values files (applied in order)
    for vf in (values_files or []):
        if not os.path.isfile(vf):
            raise ValueError(f"Values file not found: {vf}")
        with open(vf, "r", encoding="utf-8") as f:
            data = yaml.safe_load(f)
        if isinstance(data, dict):
            _deep_merge(merged, data)

    # 3. --set overrides (highest precedence)
    for override in (set_overrides or []):
        if "=" not in override:
            raise ValueError(f"--set override must be key=value, got: {override}")
        key, raw_value = override.split("=", 1)
        value = _infer_type(raw_value)
        nested = _parse_dot_notation(key, value)
        _deep_merge(merged, nested)

    return merged


def render_template(directory, values_files=None, set_overrides=None, env_file=None):
    """Read template.yaml, load values, render with Jinja2, return rendered text."""
    path = os.path.join(directory, "template.yaml")
    if not os.path.isfile(path):
        raise ValueError(f"template.yaml not found in {directory}")

    with open(path, "r", encoding="utf-8") as f:
        raw = f.read()

    values = load_values(directory, values_files=values_files, set_overrides=set_overrides)

    # Load .env file if present or explicitly specified
    env_vars = {}
    dotenv_path = env_file
    if not dotenv_path:
        default_dotenv = os.path.join(directory, ".env")
        if os.path.isfile(default_dotenv):
            dotenv_path = default_dotenv
    if dotenv_path:
        if not os.path.isfile(dotenv_path):
            raise ValueError(f"env file not found: {dotenv_path}")
        env_vars = parse_dotenv(dotenv_path)

    # Fast path: no values, no env vars, and no Jinja2 syntax
    if not values and not env_vars and "{{" not in raw and "{%" not in raw:
        return raw

    try:
        import jinja2
    except ImportError:
        raise ImportError(
            "Jinja2 is required for template rendering but is not installed. "
            "Install it with: pip install jinja2"
        )

    # Helm-style {{ .Values.key }} -> {{ Values.key }} for Jinja2 compatibility
    raw = raw.replace("{{ .Values.", "{{ Values.")
    raw = raw.replace("{{- .Values.", "{{- Values.")
    raw = raw.replace("{{ .Env.", "{{ Env.")
    raw = raw.replace("{{- .Env.", "{{- Env.")

    env = jinja2.Environment(
        undefined=jinja2.StrictUndefined,
        trim_blocks=True,
        lstrip_blocks=True,
    )
    template_obj = env.from_string(raw)
    try:
        rendered = template_obj.render(Values=values, Env=env_vars)
    except jinja2.UndefinedError as e:
        raise ValueError(f"Template rendering error: {e}")

    return rendered


# ---------------------------------------------------------------------------
# Common helpers
# ---------------------------------------------------------------------------

def _run_json(cmd, workspace_id=None):
    """Run a multica command and return parsed JSON."""
    if workspace_id:
        cmd = cmd + ["--workspace-id", workspace_id]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error running command: {' '.join(cmd)}", file=sys.stderr)
        print(f"stderr: {result.stderr}", file=sys.stderr)
        sys.exit(result.returncode)
    stdout = result.stdout.strip()
    if not stdout:
        return None
    return json.loads(stdout)


def _run_cmd(cmd, dry_run=False, workspace_id=None):
    """Run a multica command, or print it in dry-run mode."""
    if workspace_id:
        cmd = cmd + ["--workspace-id", workspace_id]
    if dry_run:
        print(f"  [dry-run] {' '.join(cmd)}")
        return None
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error running command: {' '.join(cmd)}", file=sys.stderr)
        print(f"stderr: {result.stderr}", file=sys.stderr)
        sys.exit(result.returncode)
    stdout = result.stdout.strip()
    if stdout:
        try:
            return json.loads(stdout)
        except json.JSONDecodeError:
            return stdout
    return None


def _flag(key, value):
    if value is None:
        return []
    if isinstance(value, (list, dict)):
        value = json.dumps(value)
    return [key, str(value)]


def _get_id(result):
    if isinstance(result, dict):
        return result.get("id")
    return None


def _parse_workspace_list_table():
    """Run 'multica workspace list' and parse the ID/NAME table."""
    result = subprocess.run(
        ["multica", "workspace", "list"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"Error running command: multica workspace list", file=sys.stderr)
        print(f"stderr: {result.stderr}", file=sys.stderr)
        sys.exit(result.returncode)

    lines = result.stdout.strip().splitlines()
    workspaces = {}
    for line in lines:
        line = line.strip()
        if not line or line.startswith("ID"):
            continue
        parts = line.split(None, 1)
        if len(parts) >= 2:
            ws_id = parts[0]
            ws_name = parts[1]
            workspaces[ws_name] = ws_id
    return workspaces


def _slugify(name):
    """Convert a workspace name to a URL-safe slug."""
    slug = name.lower()
    slug = re.sub(r"[^a-z0-9]+", "-", slug)
    slug = slug.strip("-")
    return slug or "workspace"


def create_workspace(name, slug=None, description=None):
    """Create a workspace via the Multica REST API."""
    server = os.environ.get("MULTICA_SERVER_URL")
    token = os.environ.get("MULTICA_TOKEN")
    if not server or not token:
        print(
            "ERROR: MULTICA_SERVER_URL and MULTICA_TOKEN must be set to create a workspace.",
            file=sys.stderr,
        )
        sys.exit(1)

    slug = slug or _slugify(name)
    payload = {"name": name, "slug": slug}
    if description:
        payload["description"] = description

    req = urllib.request.Request(
        f"{server}/api/workspaces",
        data=json.dumps(payload).encode("utf-8"),
        headers={
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
        },
        method="POST",
    )

    try:
        with urllib.request.urlopen(req) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            ws_id = data.get("id")
            print(f"  Created workspace: {name} ({ws_id})")
            return ws_id
    except urllib.error.HTTPError as e:
        body = e.read().decode("utf-8")
        print(f"ERROR: Failed to create workspace '{name}': HTTP {e.code}", file=sys.stderr)
        print(f"Response: {body}", file=sys.stderr)
        sys.exit(1)
    except urllib.error.URLError as e:
        print(f"ERROR: Failed to create workspace '{name}': {e.reason}", file=sys.stderr)
        sys.exit(1)


# Test workspace UUID used as the default target for all template operations.
DRY_RUN_ID = "DRY-RUN"
DEFAULT_TEST_WORKSPACE = "b025515a-259e-4679-963d-35ba3fce947a"


# ---------------------------------------------------------------------------
# Validation constants
# ---------------------------------------------------------------------------

TOP_LEVEL_KEYS = {"apiVersion", "kind", "metadata", "spec"}
METADATA_KEYS = {"name", "description"}
SPEC_KEYS = {"targetWorkspace", "workspace", "labels", "skills", "agents", "squads", "autopilots"}

TARGET_WORKSPACE_KEYS = {"id", "name", "create", "slug"}
WORKSPACE_KEYS = {"name", "description", "issuePrefix"}
CREATE_WORKSPACE_KEYS = {"name", "description", "slug"}
LABEL_KEYS = {"name", "color"}
SKILL_KEYS = {"name", "description", "content", "files"}
SKILL_FILE_KEYS = {"path", "content"}
AGENT_KEYS = {
    "name", "description", "runtimeId", "model", "instructions",
    "visibility", "maxConcurrentTasks", "customArgs", "customEnv", "skills", "envFile",
}
SQUAD_KEYS = {"name", "description", "instructions", "leader", "members"}
AUTOPILOT_KEYS = {"name", "title", "agent", "mode", "description", "priority", "status", "triggers"}
TRIGGER_KEYS = {"cron", "timezone", "enabled", "label"}


# ---------------------------------------------------------------------------
# Validation
# ---------------------------------------------------------------------------

def _validate_keys(obj, allowed, path):
    if not isinstance(obj, dict):
        raise ValueError(f"{path} must be a mapping")
    unknown = set(obj.keys()) - allowed
    if unknown:
        raise ValueError(f"{path} contains unknown keys: {', '.join(sorted(unknown))}")


def load_template(directory, values_files=None, set_overrides=None, env_file=None):
    path = os.path.join(directory, "template.yaml")
    if not os.path.isfile(path):
        raise ValueError(f"template.yaml not found in {directory}")

    raw = render_template(directory, values_files=values_files, set_overrides=set_overrides, env_file=env_file)
    data = yaml.safe_load(raw)

    if not isinstance(data, dict):
        raise ValueError("template.yaml must contain a mapping")

    _validate_keys(data, TOP_LEVEL_KEYS, "template")

    if data.get("apiVersion") != "multica.template/v1":
        raise ValueError(
            f"apiVersion must be 'multica.template/v1', got {data.get('apiVersion')!r}"
        )
    if data.get("kind") != "WorkspaceTemplate":
        raise ValueError(
            f"kind must be 'WorkspaceTemplate', got {data.get('kind')!r}"
        )

    metadata = data.get("metadata") or {}
    if not isinstance(metadata, dict):
        raise ValueError("metadata must be a mapping")
    _validate_keys(metadata, METADATA_KEYS, "metadata")
    if not metadata.get("name"):
        raise ValueError("metadata.name is required")

    spec = data.get("spec")
    if not isinstance(spec, dict):
        raise ValueError("spec is required and must be a mapping")
    _validate_keys(spec, SPEC_KEYS, "spec")

    # Validate sub-resources
    if "targetWorkspace" in spec:
        _validate_keys(spec["targetWorkspace"], TARGET_WORKSPACE_KEYS, "spec.targetWorkspace")

    if "workspace" in spec:
        _validate_keys(spec["workspace"], WORKSPACE_KEYS, "spec.workspace")

    for i, label in enumerate(spec.get("labels") or []):
        _validate_keys(label, LABEL_KEYS, f"spec.labels[{i}]")
        if not label.get("name"):
            raise ValueError(f"spec.labels[{i}].name is required")

    for i, skill in enumerate(spec.get("skills") or []):
        _validate_keys(skill, SKILL_KEYS, f"spec.skills[{i}]")
        if not skill.get("name"):
            raise ValueError(f"spec.skills[{i}].name is required")
        for j, sf in enumerate(skill.get("files") or []):
            _validate_keys(sf, SKILL_FILE_KEYS, f"spec.skills[{i}].files[{j}]")

    for i, agent in enumerate(spec.get("agents") or []):
        _validate_keys(agent, AGENT_KEYS, f"spec.agents[{i}]")
        if not agent.get("name"):
            raise ValueError(f"spec.agents[{i}].name is required")

    for i, squad in enumerate(spec.get("squads") or []):
        _validate_keys(squad, SQUAD_KEYS, f"spec.squads[{i}]")
        if not squad.get("name"):
            raise ValueError(f"spec.squads[{i}].name is required")
        if not squad.get("leader"):
            raise ValueError(f"spec.squads[{i}].leader is required")

    for i, autopilot in enumerate(spec.get("autopilots") or []):
        _validate_keys(autopilot, AUTOPILOT_KEYS, f"spec.autopilots[{i}]")
        if not autopilot.get("name"):
            raise ValueError(f"spec.autopilots[{i}].name is required")
        if not autopilot.get("agent"):
            raise ValueError(f"spec.autopilots[{i}].agent is required")
        for j, trigger in enumerate(autopilot.get("triggers") or []):
            _validate_keys(trigger, TRIGGER_KEYS, f"spec.autopilots[{i}].triggers[{j}]")

    return data


# ---------------------------------------------------------------------------
# Workspace resolution
# ---------------------------------------------------------------------------

def resolve_workspace(args, template=None, dry_run=False):
    """Resolve target workspace according to precedence rules.

    Precedence:
        --workspace-id > --workspace-name > spec.targetWorkspace.id >
        spec.targetWorkspace.name > MULTICA_WORKSPACE_ID env var >
        DEFAULT_TEST_WORKSPACE
    """
    spec = (template.get("spec") or {}) if template else {}
    target = spec.get("targetWorkspace") or {}

    if getattr(args, "workspace_id", None):
        return args.workspace_id

    if getattr(args, "workspace_name", None):
        name = args.workspace_name
        workspaces = _parse_workspace_list_table()
        if name not in workspaces:
            if getattr(args, "create_workspace", False):
                if dry_run:
                    print(f'Workspace "{name}" not found. Would create (dry-run).')
                    return DRY_RUN_ID
                print(f'Workspace "{name}" not found. Creating...')
                return create_workspace(name)
            print(
                f'Workspace "{name}" not found. Create it via the web UI first.',
                file=sys.stderr,
            )
            sys.exit(1)
        return workspaces[name]

    if target.get("id"):
        return target["id"]

    if target.get("name"):
        name = target["name"]
        workspaces = _parse_workspace_list_table()
        if name not in workspaces:
            if target.get("create") or getattr(args, "create_workspace", False):
                if dry_run:
                    print(f'Workspace "{name}" not found. Would create (dry-run).')
                    return DRY_RUN_ID
                print(f'Workspace "{name}" not found. Creating...')
                ws_description = None
                if template and template.get("spec", {}).get("workspace", {}).get("description"):
                    ws_description = template["spec"]["workspace"]["description"]
                return create_workspace(name, slug=target.get("slug"), description=ws_description)
            print(
                f'Workspace "{name}" not found. Create it via the web UI first.',
                file=sys.stderr,
            )
            sys.exit(1)
        return workspaces[name]

    env_ws = os.environ.get("MULTICA_WORKSPACE_ID")
    if env_ws:
        return env_ws

    return DEFAULT_TEST_WORKSPACE


def resolve_workspace_simple(args):
    """Resolve workspace for dump/clone source (no template, no create)."""
    if getattr(args, "workspace_id", None):
        return args.workspace_id

    if getattr(args, "workspace_name", None):
        name = args.workspace_name
        workspaces = _parse_workspace_list_table()
        if name not in workspaces:
            print(
                f'Workspace "{name}" not found.',
                file=sys.stderr,
            )
            sys.exit(1)
        return workspaces[name]

    env_ws = os.environ.get("MULTICA_WORKSPACE_ID")
    if env_ws:
        return env_ws

    return None


# ---------------------------------------------------------------------------
# Registry
# ---------------------------------------------------------------------------

def build_registry(workspace_id=None):
    """Query the target workspace and build a (type, name) -> id registry."""
    registry = {}
    if workspace_id == DRY_RUN_ID:
        return registry

    ws = _run_json(["multica", "workspace", "get", "--output", "json"], workspace_id=workspace_id)
    if isinstance(ws, dict):
        registry[("workspace", ws.get("name"))] = ws.get("id")

    labels = _run_json(["multica", "label", "list", "--output", "json"], workspace_id=workspace_id)
    if isinstance(labels, list):
        for item in labels:
            registry[("label", item.get("name"))] = item.get("id")

    skills = _run_json(["multica", "skill", "list", "--output", "json"], workspace_id=workspace_id)
    if isinstance(skills, list):
        for item in skills:
            registry[("skill", item.get("name"))] = item.get("id")

    agents = _run_json(["multica", "agent", "list", "--output", "json"], workspace_id=workspace_id)
    if isinstance(agents, list):
        for item in agents:
            registry[("agent", item.get("name"))] = item.get("id")

    squads = _run_json(["multica", "squad", "list", "--output", "json"], workspace_id=workspace_id)
    if isinstance(squads, list):
        for item in squads:
            registry[("squad", item.get("name"))] = item.get("id")

    autopilots_resp = _run_json(["multica", "autopilot", "list", "--output", "json"], workspace_id=workspace_id)
    autopilots = []
    if isinstance(autopilots_resp, dict):
        autopilots = autopilots_resp.get("autopilots", [])
    elif isinstance(autopilots_resp, list):
        autopilots = autopilots_resp
    for item in autopilots:
        key = item.get("title") or item.get("name")
        if key:
            registry[("autopilot", key)] = item.get("id")

    return registry


# ---------------------------------------------------------------------------
# Apply functions
# ---------------------------------------------------------------------------

def apply_workspace(spec, dry_run=False, workspace_id=None):
    ws = spec.get("workspace")
    if not ws:
        return
    print("[workspace] updating metadata")
    cmd = ["multica", "workspace", "update", "--output", "json"]
    cmd.extend(_flag("--name", ws.get("name")))
    cmd.extend(_flag("--description", ws.get("description")))
    cmd.extend(_flag("--issue-prefix", ws.get("issuePrefix")))
    _run_cmd(cmd, dry_run=dry_run, workspace_id=workspace_id)


def apply_labels(spec, registry, dry_run=False, workspace_id=None):
    for label in spec.get("labels") or []:
        name = label["name"]
        key = ("label", name)
        if key in registry:
            print(f"[label] {name} — updating")
            cmd = ["multica", "label", "update", registry[key], "--output", "json"]
        else:
            print(f"[label] {name} — creating")
            cmd = ["multica", "label", "create", "--output", "json"]
        cmd.extend(_flag("--name", name))
        cmd.extend(_flag("--color", label.get("color")))
        result = _run_cmd(cmd, dry_run=dry_run, workspace_id=workspace_id)
        if result:
            registry[key] = _get_id(result)


def apply_skills(spec, registry, dry_run=False, workspace_id=None):
    for skill in spec.get("skills") or []:
        name = skill["name"]
        key = ("skill", name)
        exists = key in registry
        action = "updating" if exists else "creating"
        print(f"[skill] {name} — {action}")
        cmd = ["multica", "skill", "update" if exists else "create", "--output", "json"]
        if exists:
            cmd.append(registry[key])
        cmd.extend(_flag("--name", name))
        cmd.extend(_flag("--description", skill.get("description")))
        cmd.extend(_flag("--content", skill.get("content")))
        result = _run_cmd(cmd, dry_run=dry_run, workspace_id=workspace_id)

        skill_id = registry.get(key)
        if not skill_id and dry_run:
            skill_id = DRY_RUN_ID
        elif result:
            skill_id = _get_id(result) or skill_id
        if skill_id:
            registry[key] = skill_id

        for sf in skill.get("files") or []:
            print(f"[skill] {name} — upsert file {sf['path']}")
            fcmd = ["multica", "skill", "files", "upsert", skill_id, "--output", "json"]
            fcmd.extend(_flag("--path", sf["path"]))
            fcmd.extend(_flag("--content", sf["content"]))
            _run_cmd(fcmd, dry_run=dry_run, workspace_id=workspace_id)


def get_available_runtimes(workspace_id=None):
    """Return list of available runtime dicts in the target workspace."""
    cmd = ["multica", "runtime", "list", "--output", "json"]
    if workspace_id:
        cmd = cmd + ["--workspace-id", workspace_id]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        return []
    stdout = result.stdout.strip()
    if not stdout:
        return []
    try:
        data = json.loads(stdout)
        if isinstance(data, list):
            return data
    except json.JSONDecodeError:
        pass
    return []


def _runtime_label(runtime):
    """Return a human-readable label for a runtime dict."""
    if not runtime:
        return "unknown"
    parts = [runtime.get("name") or runtime.get("id", "unknown")]
    provider = runtime.get("provider")
    if provider:
        parts.append(f"provider={provider}")
    return " ".join(parts)


def _resolve_runtime_id(agent, available_runtimes):
    """Validate agent runtimeId and fall back to first available if invalid."""
    name = agent["name"]
    requested = agent.get("runtimeId")

    runtime_by_id = {r.get("id"): r for r in available_runtimes if r.get("id")}

    if requested and requested in runtime_by_id:
        return requested

    if available_runtimes:
        fallback = available_runtimes[0].get("id")
        fallback_label = _runtime_label(available_runtimes[0])
        if requested:
            print(
                f"[agent] {name} — WARNING: runtimeId {requested!r} not found in target workspace, falling back to {fallback!r} ({fallback_label})",
                file=sys.stderr,
            )
        else:
            print(
                f"[agent] {name} — WARNING: no runtimeId specified, falling back to {fallback!r} ({fallback_label})",
                file=sys.stderr,
            )
        return fallback

    print(
        f"[agent] {name} — ERROR: no runtimes available in target workspace",
        file=sys.stderr,
    )
    sys.exit(1)


def apply_agents(spec, registry, dry_run=False, workspace_id=None, source_dir=None):
    available_runtimes = get_available_runtimes(workspace_id=workspace_id)

    for agent in spec.get("agents") or []:
        name = agent["name"]
        key = ("agent", name)
        exists = key in registry
        action = "updating" if exists else "creating"
        model = agent.get("model")
        model_hint = f" model={model}" if model else ""
        print(f"[agent] {name} — {action}{model_hint}")

        # Merge customEnv with envFile if specified
        custom_env = dict(agent.get("customEnv") or {})
        env_file = agent.get("envFile")
        if env_file and source_dir:
            env_path = os.path.join(source_dir, env_file)
            if os.path.isfile(env_path):
                file_env = parse_dotenv(env_path)
                # customEnv takes precedence over envFile
                merged = dict(file_env)
                merged.update(custom_env)
                custom_env = merged
            else:
                print(f"[agent] {name} — WARNING: envFile not found: {env_path}", file=sys.stderr)

        cmd = ["multica", "agent", "update" if exists else "create", "--output", "json"]
        if exists:
            cmd.append(registry[key])
        cmd.extend(_flag("--name", name))
        cmd.extend(_flag("--description", agent.get("description")))
        resolved_runtime = _resolve_runtime_id(agent, available_runtimes)
        cmd.extend(_flag("--runtime-id", resolved_runtime))
        cmd.extend(_flag("--model", agent.get("model")))
        cmd.extend(_flag("--instructions", agent.get("instructions")))
        cmd.extend(_flag("--visibility", agent.get("visibility")))
        cmd.extend(_flag("--max-concurrent-tasks", agent.get("maxConcurrentTasks")))
        cmd.extend(_flag("--custom-args", agent.get("customArgs")))
        cmd.extend(_flag("--custom-env", custom_env if custom_env else None))
        result = _run_cmd(cmd, dry_run=dry_run, workspace_id=workspace_id)

        agent_id = registry.get(key)
        if not agent_id and dry_run:
            agent_id = DRY_RUN_ID
        elif result:
            agent_id = _get_id(result) or agent_id
        if agent_id:
            registry[key] = agent_id

    # Final pass: skill bindings
    for agent in spec.get("agents") or []:
        name = agent["name"]
        skills = agent.get("skills") or []
        if not skills:
            continue
        skill_ids = []
        for skill_name in skills:
            sk = ("skill", skill_name)
            if sk not in registry:
                print(
                    f"[agent] {name} — ERROR: referenced skill '{skill_name}' not found",
                    file=sys.stderr,
                )
                sys.exit(1)
            skill_ids.append(registry[sk])
        agent_key = ("agent", name)
        agent_id = registry.get(agent_key)
        if not agent_id:
            print(f"[agent] {name} — ERROR: agent ID not found after apply", file=sys.stderr)
            sys.exit(1)
        print(f"[agent] {name} — setting skills ({', '.join(skills)})")
        cmd = ["multica", "agent", "skills", "set", agent_id, "--output", "json"]
        cmd.extend(_flag("--skill-ids", ",".join(skill_ids)))
        _run_cmd(cmd, dry_run=dry_run, workspace_id=workspace_id)


def apply_squads(spec, registry, dry_run=False, workspace_id=None):
    # Pre-fetch workspace members for resolving human member names
    workspace_members = fetch_workspace_members_list(workspace_id=workspace_id)
    member_name_to_id = {m["name"]: m["id"] for m in workspace_members}

    for squad in spec.get("squads") or []:
        name = squad["name"]
        leader_name = squad.get("leader")
        if not leader_name:
            print(f"[squad] {name} — ERROR: leader is required", file=sys.stderr)
            sys.exit(1)
        leader_key = ("agent", leader_name)
        if leader_key not in registry:
            print(
                f"[squad] {name} — ERROR: leader agent '{leader_name}' not found",
                file=sys.stderr,
            )
            sys.exit(1)
        leader_id = registry[leader_key]
        key = ("squad", name)
        exists = key in registry
        action = "updating" if exists else "creating"
        print(f"[squad] {name} — {action}")
        cmd = ["multica", "squad", "update" if exists else "create", "--output", "json"]
        if exists:
            cmd.append(registry[key])
        cmd.extend(_flag("--name", name))
        cmd.extend(_flag("--leader", leader_id))
        cmd.extend(_flag("--description", squad.get("description")))
        # Note: squad create does not support --instructions; apply it via update after creation
        if exists:
            cmd.extend(_flag("--instructions", squad.get("instructions")))
        result = _run_cmd(cmd, dry_run=dry_run, workspace_id=workspace_id)

        squad_id = registry.get(key)
        if not squad_id and dry_run:
            squad_id = DRY_RUN_ID
        elif result:
            squad_id = _get_id(result) or squad_id
        if squad_id:
            registry[key] = squad_id

        # Apply instructions for newly-created squads via a follow-up update
        if not exists and squad_id and squad.get("instructions"):
            print(f"[squad] {name} — applying instructions")
            icmd = ["multica", "squad", "update", squad_id, "--output", "json"]
            icmd.extend(_flag("--instructions", squad.get("instructions")))
            _run_cmd(icmd, dry_run=dry_run, workspace_id=workspace_id)

        # Add squad members
        # Pre-fetch existing members to skip already-present ones (idempotent apply)
        existing_members = set()
        if squad_id and not dry_run:
            for m in fetch_squad_members(squad_id, workspace_id=workspace_id):
                existing_members.add((m.get("member_id"), m.get("member_type", "agent")))

        for member in squad.get("members") or []:
            member_name = member.get("name")
            member_type = member.get("type", "agent")
            role = member.get("role", "member")

            if member_type == "agent":
                member_key = ("agent", member_name)
                if member_key not in registry:
                    print(
                        f"[squad] {name} — WARNING: member agent '{member_name}' not found, skipping",
                        file=sys.stderr,
                    )
                    continue
                member_id = registry[member_key]
            elif member_type == "member":
                if member_name not in member_name_to_id:
                    print(
                        f"[squad] {name} — WARNING: member '{member_name}' not found in workspace, skipping",
                        file=sys.stderr,
                    )
                    continue
                member_id = member_name_to_id[member_name]
            else:
                print(
                    f"[squad] {name} — WARNING: unknown member type '{member_type}', skipping",
                    file=sys.stderr,
                )
                continue

            if (member_id, member_type) in existing_members:
                print(f"[squad] {name} — member {member_name} already present, skipping")
                continue

            print(f"[squad] {name} — adding member {member_name} ({member_type}, role={role})")
            mcmd = [
                "multica", "squad", "member", "add", squad_id,
                "--output", "json",
            ]
            mcmd.extend(_flag("--member-id", member_id))
            mcmd.extend(_flag("--type", member_type))
            mcmd.extend(_flag("--role", role))
            _run_cmd(mcmd, dry_run=dry_run, workspace_id=workspace_id)


def apply_autopilots(spec, registry, dry_run=False, workspace_id=None):
    for autopilot in spec.get("autopilots") or []:
        name = autopilot.get("name")
        title = autopilot.get("title") or name
        agent_name = autopilot.get("agent")
        if not agent_name:
            print(f"[autopilot] {title} — ERROR: agent is required", file=sys.stderr)
            sys.exit(1)
        agent_key = ("agent", agent_name)
        if agent_key not in registry:
            print(
                f"[autopilot] {title} — ERROR: agent '{agent_name}' not found",
                file=sys.stderr,
            )
            sys.exit(1)
        agent_id = registry[agent_key]
        key = ("autopilot", title)
        exists = key in registry
        action = "updating" if exists else "creating"
        print(f"[autopilot] {title} — {action}")
        cmd = ["multica", "autopilot", "update" if exists else "create", "--output", "json"]
        if exists:
            cmd.append(registry[key])
        cmd.extend(_flag("--title", title))
        cmd.extend(_flag("--agent", agent_id))
        cmd.extend(_flag("--mode", autopilot.get("mode")))
        cmd.extend(_flag("--description", autopilot.get("description")))
        cmd.extend(_flag("--priority", autopilot.get("priority")))
        if exists:
            cmd.extend(_flag("--status", autopilot.get("status")))
        result = _run_cmd(cmd, dry_run=dry_run, workspace_id=workspace_id)

        autopilot_id = registry.get(key)
        if not autopilot_id and dry_run:
            autopilot_id = DRY_RUN_ID
        elif result:
            autopilot_id = _get_id(result) or autopilot_id
        if autopilot_id:
            registry[key] = autopilot_id

        # Sync triggers
        triggers = autopilot.get("triggers") or []
        if autopilot_id and triggers and not dry_run:
            existing_triggers = _run_json(
                ["multica", "autopilot", "get", autopilot_id, "--output", "json"],
                workspace_id=workspace_id,
            )
            existing = []
            if existing_triggers and isinstance(existing_triggers, dict):
                existing = existing_triggers.get("triggers", [])

            # Map existing triggers by cron for matching
            existing_by_cron = {t.get("cron_expression"): t for t in existing if t.get("cron_expression")}

            for trig in triggers:
                cron = trig.get("cron")
                timezone = trig.get("timezone")
                enabled = trig.get("enabled")
                label = trig.get("label")

                if not cron:
                    continue

                existing_trig = existing_by_cron.get(cron)
                if existing_trig:
                    trig_id = existing_trig["id"]
                    print(f"[autopilot] {title} — updating trigger {cron}")
                    tcmd = ["multica", "autopilot", "trigger-update", autopilot_id, trig_id, "--output", "json"]
                    tcmd.extend(_flag("--cron", cron))
                    tcmd.extend(_flag("--timezone", timezone))
                    if enabled is not None:
                        tcmd.extend(["--enabled", "true" if enabled else "false"])
                    tcmd.extend(_flag("--label", label))
                    _run_cmd(tcmd, dry_run=dry_run, workspace_id=workspace_id)
                else:
                    print(f"[autopilot] {title} — adding trigger {cron}")
                    tcmd = ["multica", "autopilot", "trigger-add", autopilot_id, "--output", "json"]
                    tcmd.extend(_flag("--cron", cron))
                    tcmd.extend(_flag("--timezone", timezone))
                    tcmd.extend(_flag("--label", label))
                    _run_cmd(tcmd, dry_run=dry_run, workspace_id=workspace_id)
                    # trigger-add does not support --enabled; disable via trigger-update if needed
                    if enabled is False:
                        # Re-fetch to get the newly created trigger id
                        refreshed = _run_json(
                            ["multica", "autopilot", "get", autopilot_id, "--output", "json"],
                            workspace_id=workspace_id,
                        )
                        refreshed_trig = None
                        if refreshed and isinstance(refreshed, dict):
                            for t in refreshed.get("triggers", []):
                                if t.get("cron_expression") == cron:
                                    refreshed_trig = t
                                    break
                        if refreshed_trig:
                            print(f"[autopilot] {title} — disabling trigger {cron}")
                            dcmd = ["multica", "autopilot", "trigger-update", autopilot_id, refreshed_trig["id"], "--output", "json"]
                            dcmd.extend(["--enabled", "false"])
                            _run_cmd(dcmd, dry_run=dry_run, workspace_id=workspace_id)


# ---------------------------------------------------------------------------
# GitHub fetching
# ---------------------------------------------------------------------------

def is_github_url(value):
    """Return True if value looks like a GitHub repo reference."""
    if not value:
        return False
    return (
        value.startswith("https://github.com/")
        or value.startswith("http://github.com/")
        or value.startswith("github.com/")
    )


def parse_github_url(url):
    """Parse a GitHub reference into (owner, repo, path, ref).

    Supported forms:
        github.com/owner/repo
        github.com/owner/repo/path/to/dir
        https://github.com/owner/repo
        https://github.com/owner/repo/tree/REF/path
        https://github.com/owner/repo/blob/REF/path

    Returns a dict with keys: owner, repo, path, ref.
    ref and path may be None.
    """
    original = url
    # Normalise scheme
    if url.startswith("http://"):
        url = url[len("http://"):]
    elif url.startswith("https://"):
        url = url[len("https://"):]

    if not url.startswith("github.com/"):
        raise ValueError(f"Unsupported GitHub URL: {original}")

    parts = url[len("github.com/"):].split("/")
    if len(parts) < 2:
        raise ValueError(f"Invalid GitHub URL: {original}")

    owner = parts[0]
    repo = parts[1]
    path = None
    ref = None

    # Check for tree/blob URLs: github.com/owner/repo/tree/REF/path
    if len(parts) >= 4 and parts[2] in ("tree", "blob"):
        ref = parts[3]
        if len(parts) > 4:
            path = "/".join(parts[4:])
    else:
        # Remaining parts after owner/repo are the subdirectory path
        if len(parts) > 2:
            path = "/".join(parts[2:])

    return {"owner": owner, "repo": repo, "path": path, "ref": ref}


def fetch_github_repo(parsed, explicit_ref=None):
    """Clone a GitHub repository into a temporary directory.

    If explicit_ref is provided it overrides any ref extracted from the URL.
    Returns a tuple (target_path, tmpdir) where tmpdir is the temporary
    clone directory that the caller must clean up.
    """
    ref = explicit_ref or parsed.get("ref")
    clone_url = f"https://github.com/{parsed['owner']}/{parsed['repo']}.git"

    tmpdir = tempfile.mkdtemp(prefix="multica-template-")
    try:
        print(f"Fetching {clone_url}" + (f" (ref: {ref})" if ref else "") + " ...")
        cmd = ["git", "clone", "--depth", "1"]
        if ref:
            cmd += ["--branch", ref]
        cmd += [clone_url, tmpdir]
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"Error cloning repository: {result.stderr}", file=sys.stderr)
            shutil.rmtree(tmpdir, ignore_errors=True)
            sys.exit(1)

        target = tmpdir
        if parsed.get("path"):
            target = os.path.join(tmpdir, parsed["path"])
            if not os.path.isdir(target):
                print(
                    f"Path '{parsed['path']}' not found in repository.",
                    file=sys.stderr,
                )
                shutil.rmtree(tmpdir, ignore_errors=True)
                sys.exit(1)
        return target, tmpdir
    except Exception:
        shutil.rmtree(tmpdir, ignore_errors=True)
        raise


