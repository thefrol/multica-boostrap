#!/usr/bin/env python3
"""
multica-template-apply — Backward-compatible wrapper for 'multica-template apply'.

Usage:
    multica-template-apply ./examples/basic-workspace
    multica-template-apply ./examples/agent-fleet --dry-run
    multica-template-apply ./examples/full-stack --workspace-id <uuid>
    multica-template-apply ./examples/full-stack --workspace-name "Team Alpha"
"""

import os
import subprocess
import sys


def main():
    # Forward everything to the unified CLI
    script_dir = os.path.dirname(os.path.abspath(__file__))
    unified = os.path.join(script_dir, "multica-template")
    cmd = [sys.executable, unified, "apply"] + sys.argv[1:]
    sys.exit(subprocess.run(cmd).returncode)


if __name__ == "__main__":
    main()
