#!/usr/bin/env python3
"""
multica-template-dump — Backward-compatible wrapper for 'multica-template dump'.

Usage:
    multica-template-dump ./exported-template
    multica-template-dump ./exported-template --workspace-id <uuid>
    multica-template-dump ./exported-template --workspace-name "Team Alpha"
"""

import os
import subprocess
import sys


def main():
    # Forward everything to the unified CLI (repo root or installed path)
    script_dir = os.path.dirname(os.path.abspath(__file__))
    repo_root = os.path.dirname(script_dir)
    unified = os.path.join(repo_root, "multica-template")
    if not os.path.isfile(unified):
        # Fallback to installed PATH location
        unified = "multica-template"
    cmd = [sys.executable, unified, "dump"] + sys.argv[1:]
    sys.exit(subprocess.run(cmd).returncode)


if __name__ == "__main__":
    main()
