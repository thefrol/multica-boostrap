#!/usr/bin/env python3
"""
multica-template-dump — Export a Multica workspace to a declarative template.

Usage:
    multica-template-dump ./exported-template
    multica-template-dump ./exported-template --workspace-id <uuid>
    multica-template-dump ./exported-template --workspace-name "Team Alpha"
"""

import argparse
import json
import os
import subprocess
import sys

import yaml


# ---------------------------------------------------------------------------
# Workspace resolution
# ---------------------------------------------------------------------------

def _parse_workspace_list_table():
    """Run 'multica workspace list' and parse the ID/NAME table."""
    result = subprocess.run(
        ["multica", "workspace", "list"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"Error running command: multica workspace list", file=sys.stderr)
        print(f"stderr: {result.stderr}", file=sys.stderr)
        sys.exit(result.returncode)

    lines = result.stdout.strip().splitlines()
    workspaces = {}
    for line in lines:
        line = line.strip()
        if not line or line.startswith("ID"):
            continue
        parts = line.split(None, 1)
        if len(parts) >= 2:
            ws_id = parts[0]
            ws_name = parts[1]
            workspaces[ws_name] = ws_id
    return workspaces


def resolve_workspace(args):
    """Resolve target workspace according to precedence rules."""
    if args.workspace_id:
        return args.workspace_id

    if args.workspace_name:
        name = args.workspace_name
        workspaces = _parse_workspace_list_table()
        if name not in workspaces:
            print(
                f'Workspace "{name}" not found.',
                file=sys.stderr,
            )
            sys.exit(1)
        return workspaces[name]

    env_ws = os.environ.get("MULTICA_WORKSPACE_ID")
    if env_ws:
        return env_ws

    return None


# ---------------------------------------------------------------------------
# JSON helpers
# ---------------------------------------------------------------------------

def _run_json(cmd, workspace_id=None):
    """Run a multica command and return parsed JSON."""
    if workspace_id:
        cmd = cmd + ["--workspace-id", workspace_id]
    result = subprocess.run(cmd, capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error running command: {' '.join(cmd)}", file=sys.stderr)
        print(f"stderr: {result.stderr}", file=sys.stderr)
        sys.exit(result.returncode)
    stdout = result.stdout.strip()
    if not stdout:
        return None
    return json.loads(stdout)


# ---------------------------------------------------------------------------
# Fetchers
# ---------------------------------------------------------------------------

def fetch_workspace(workspace_id=None):
    """Fetch workspace metadata."""
    return _run_json(["multica", "workspace", "get", "--output", "json"], workspace_id=workspace_id)


def fetch_labels(workspace_id=None):
    """Fetch labels list."""
    return _run_json(["multica", "label", "list", "--output", "json"], workspace_id=workspace_id) or []


def fetch_skills(workspace_id=None):
    """Fetch skills with full content and files."""
    skills = _run_json(["multica", "skill", "list", "--output", "json"], workspace_id=workspace_id) or []
    full_skills = []
    for skill in skills:
        detail = _run_json(["multica", "skill", "get", skill["id"], "--output", "json"], workspace_id=workspace_id)
        if detail:
            full_skills.append(detail)
        else:
            full_skills.append(skill)
    return full_skills


def fetch_agents(workspace_id=None):
    """Fetch agents with full details."""
    agents = _run_json(["multica", "agent", "list", "--output", "json"], workspace_id=workspace_id) or []
    full_agents = []
    for agent in agents:
        detail = _run_json(["multica", "agent", "get", agent["id"], "--output", "json"], workspace_id=workspace_id)
        if detail:
            full_agents.append(detail)
        else:
            full_agents.append(agent)
    return full_agents


def fetch_squads(workspace_id=None):
    """Fetch squads list."""
    return _run_json(["multica", "squad", "list", "--output", "json"], workspace_id=workspace_id) or []


def fetch_autopilots(workspace_id=None):
    """Fetch autopilots with full details."""
    resp = _run_json(["multica", "autopilot", "list", "--output", "json"], workspace_id=workspace_id)
    autopilots = []
    if isinstance(resp, dict):
        autopilots = resp.get("autopilots", [])
    elif isinstance(resp, list):
        autopilots = resp

    full_autopilots = []
    for ap in autopilots:
        detail = _run_json(["multica", "autopilot", "get", ap["id"], "--output", "json"], workspace_id=workspace_id)
        if detail and isinstance(detail, dict) and "autopilot" in detail:
            full_autopilots.append(detail["autopilot"])
        else:
            full_autopilots.append(ap)
    return full_autopilots


# ---------------------------------------------------------------------------
# Builders
# ---------------------------------------------------------------------------

def build_template(workspace_id=None):
    """Query the workspace and build a template dict."""
    ws = fetch_workspace(workspace_id=workspace_id)
    labels = fetch_labels(workspace_id=workspace_id)
    skills = fetch_skills(workspace_id=workspace_id)
    agents = fetch_agents(workspace_id=workspace_id)
    squads = fetch_squads(workspace_id=workspace_id)
    autopilots = fetch_autopilots(workspace_id=workspace_id)

    # Build lookup tables: id -> name
    agent_id_to_name = {a["id"]: a["name"] for a in agents}
    skill_id_to_name = {s["id"]: s["name"] for s in skills}

    template = {
        "apiVersion": "multica.template/v1",
        "kind": "WorkspaceTemplate",
        "metadata": {
            "name": ws.get("slug", "exported") if ws else "exported",
            "description": f"Auto-exported from workspace {ws.get('name', '')}" if ws else "Auto-exported workspace template",
        },
        "spec": {},
    }

    # Workspace metadata
    if ws:
        ws_spec = {}
        if ws.get("name"):
            ws_spec["name"] = ws["name"]
        if ws.get("description"):
            ws_spec["description"] = ws["description"]
        if ws.get("issue_prefix"):
            ws_spec["issuePrefix"] = ws["issue_prefix"]
        if ws_spec:
            template["spec"]["workspace"] = ws_spec

    # Labels
    if labels:
        template["spec"]["labels"] = [
            {"name": lbl["name"], "color": lbl["color"]}
            for lbl in labels
        ]

    # Skills
    if skills:
        skill_list = []
        for skill in skills:
            s = {
                "name": skill["name"],
            }
            if skill.get("description"):
                s["description"] = skill["description"]
            if skill.get("content"):
                s["content"] = skill["content"]
            if skill.get("files"):
                files = []
                for f in skill["files"]:
                    files.append({
                        "path": f["path"],
                        "content": f["content"],
                    })
                s["files"] = files
            skill_list.append(s)
        template["spec"]["skills"] = skill_list

    # Agents
    if agents:
        agent_list = []
        for agent in agents:
            a = {
                "name": agent["name"],
            }
            if agent.get("description"):
                a["description"] = agent["description"]
            if agent.get("runtime_id"):
                a["runtimeId"] = agent["runtime_id"]
            if agent.get("model"):
                a["model"] = agent["model"]
            if agent.get("instructions"):
                a["instructions"] = agent["instructions"]
            if agent.get("visibility"):
                a["visibility"] = agent["visibility"]
            if agent.get("max_concurrent_tasks") is not None:
                a["maxConcurrentTasks"] = agent["max_concurrent_tasks"]
            if agent.get("custom_args"):
                a["customArgs"] = agent["custom_args"]
            if agent.get("custom_env"):
                a["customEnv"] = agent["custom_env"]
            # Resolve skill IDs to names
            agent_skills = agent.get("skills") or []
            if agent_skills:
                skill_names = []
                for sk in agent_skills:
                    sk_id = sk["id"] if isinstance(sk, dict) else sk
                    sk_name = skill_id_to_name.get(sk_id)
                    if sk_name:
                        skill_names.append(sk_name)
                    else:
                        # Skill not found in workspace — keep as-is (won't round-trip)
                        pass
                if skill_names:
                    a["skills"] = skill_names
            agent_list.append(a)
        template["spec"]["agents"] = agent_list

    # Squads
    if squads:
        squad_list = []
        for squad in squads:
            sq = {
                "name": squad["name"],
            }
            if squad.get("description"):
                sq["description"] = squad["description"]
            leader_id = squad.get("leader_id")
            if leader_id and leader_id in agent_id_to_name:
                sq["leader"] = agent_id_to_name[leader_id]
            elif leader_id:
                # Leader agent not in workspace — use raw ID (won't round-trip well)
                sq["leader"] = leader_id
            squad_list.append(sq)
        template["spec"]["squads"] = squad_list

    # Autopilots
    if autopilots:
        autopilot_list = []
        for ap in autopilots:
            ap_out = {
                "name": ap.get("title") or ap.get("name", "unnamed"),
            }
            if ap.get("title"):
                ap_out["title"] = ap["title"]
            assignee_id = ap.get("assignee_id")
            if assignee_id and assignee_id in agent_id_to_name:
                ap_out["agent"] = agent_id_to_name[assignee_id]
            elif assignee_id:
                ap_out["agent"] = assignee_id
            if ap.get("execution_mode"):
                ap_out["mode"] = ap["execution_mode"]
            if ap.get("description"):
                ap_out["description"] = ap["description"]
            if ap.get("priority"):
                ap_out["priority"] = ap["priority"]
            if ap.get("status"):
                ap_out["status"] = ap["status"]
            autopilot_list.append(ap_out)
        template["spec"]["autopilots"] = autopilot_list

    return template


# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

def write_template(template, output_dir):
    """Write template.yaml to the output directory."""
    if not os.path.isdir(output_dir):
        os.makedirs(output_dir, exist_ok=True)

    path = os.path.join(output_dir, "template.yaml")
    with open(path, "w", encoding="utf-8") as f:
        yaml.dump(template, f, default_flow_style=False, sort_keys=False, allow_unicode=True)

    return path


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(description="Dump a Multica workspace to a declarative template.")
    parser.add_argument("output_dir", help="Path to directory where template.yaml will be written")
    parser.add_argument("--workspace-id", help="Dump from an explicit workspace UUID")
    parser.add_argument("--workspace-name", help="Resolve workspace name to ID and dump from there")
    args = parser.parse_args()

    target_ws = resolve_workspace(args)
    if target_ws:
        print(f"Source workspace: {target_ws}")
    else:
        print("Source workspace: current workspace")

    print("Fetching workspace state...")
    template = build_template(workspace_id=target_ws)

    print(f"Writing template to {args.output_dir}/template.yaml ...")
    path = write_template(template, args.output_dir)

    print(f"Done. Exported to: {path}")


if __name__ == "__main__":
    main()
